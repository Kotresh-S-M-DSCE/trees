class Solution {
    Map<Integer,List<Node>> map=new HashMap<>();
    public void Next_pointer(Node root,int level)
    {
        if(root==null)
            return;
        if(!map.containsKey(level))
            map.put(level,new ArrayList<>());
        else
        {
            List<Node> list=map.get(level);
            Node prev=list.get(list.size()-1);
            prev.next=root;
        }
        List<Node> list=map.get(level);
        list.add(root);
        Next_pointer(root.left,level+1);
        Next_pointer(root.right,level+1);
    }
    public Node connect(Node root) {
        Next_pointer(root,1);
        return root;
    }
}