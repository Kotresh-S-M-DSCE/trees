/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int findBottomLeftValue(TreeNode root) {
        List<TreeNode> list=new ArrayList<>();
        list.add(root);
        int i=0,a=0,b=0;
        while(i<=list.size()-1)
        {
            int last=list.size()-1;
            a=i;
            while(i<=last)
            {
                TreeNode temp=list.get(i++);
                if(temp.left!=null)
                    list.add(temp.left);
                if(temp.right!=null)
                    list.add(temp.right);
            }
        }
        return list.get(a).val;
    }
}