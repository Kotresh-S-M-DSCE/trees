/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int ret=0;
    public void dfs(TreeNode root,int i)
    {
        if(root==null)
            return;
        if(root.left==null&&root.right==null&&i==0)
            ret+=root.val;
        dfs(root.left,0);
        dfs(root.right,1);
    }
    public int sumOfLeftLeaves(TreeNode root) {
        dfs(root.left,0);
        dfs(root.right,1);
        return ret;
    }
}