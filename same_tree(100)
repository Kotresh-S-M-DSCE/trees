/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean compare(TreeNode p,TreeNode q)
    {
        if(p==null)
        {
            if(q!=null)
               return false;
            return true;
        }
        if(q==null)
        {
            if(p!=null)
               return false;
            return true;
        }
        if(p.val!=q.val)
           return false;
        boolean bool=compare(p.left,q.left);
        if(bool==false)
           return false;
        return compare(p.right,q.right);
    }
    public boolean isSameTree(TreeNode p, TreeNode q) {
        return compare(p,q);
    }
}