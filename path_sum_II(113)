/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    List<List<Integer>> ret=new ArrayList<>();
    public void dfs(TreeNode root,int sum,int cur,List<Integer> list)
    {
        if(root==null)
            return;
        list.add(root.val);
        if(root.left==null&&root.right==null&&cur+root.val==sum)
        {
            ret.add(new ArrayList<>(list));
            list.remove(list.size()-1);
            return;
        }
        dfs(root.left,sum,cur+root.val,list);
        dfs(root.right,sum,cur+root.val,list);
        list.remove(list.size()-1);
    }
    public List<List<Integer>> pathSum(TreeNode root, int sum) {
        dfs(root,sum,0,new ArrayList<>());
        return ret;
    }
}