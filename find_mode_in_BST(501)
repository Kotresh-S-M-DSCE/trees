/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public void dfs(TreeNode root,List<Integer> list)
    {
        if(root==null)
            return;
        dfs(root.left,list);
        list.add(root.val);
        dfs(root.right,list);
    }
    public int[] findMode(TreeNode root) {
        List<Integer> list=new ArrayList<>();
        dfs(root,list);
        List<Integer> temp=new ArrayList<>();
        int i=0,j=0,max=-1;
        while(j<list.size())
        {
            while(j<list.size()&&list.get(i).equals(list.get(j)))
                j++;
            if((j-i)>max)
            {
                max=j-i;
                temp=new ArrayList<>();
                temp.add(list.get(i));
            }
            else if((j-i)==max)
                temp.add(list.get(i));
            else{}
            i=j;
        }
        int[] ret=new int[temp.size()];
        for(i=0;i<temp.size();i++)
            ret[i]=temp.get(i);
        return ret;
    }
}