/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode(int x) { val = x; }
 * }
 */
public class Codec {
    // Encodes a tree to a single string.
    public String convert(int value)
    {
        if(value==0)
            return "0";
        int flag=0;
        StringBuilder sb=new StringBuilder();
        if(value<0)
        {
            flag=1;
            value=-value;
        }
        while(value>0)
        {
            sb.append(value%10);
            value/=10;
        }
        if(flag==1)
            sb.append('-');
        return sb.reverse().toString();
    }
    public String dfs(TreeNode root)
    {
        if(root==null)
            return null;
        StringBuilder sb=new StringBuilder();
        sb.append(convert(root.val));
        if(root.left!=null&&root.right!=null)
        {
            sb.append('(');
            sb.append(dfs(root.left));
            sb.append(')');
            sb.append('(');
            sb.append(dfs(root.right));
            sb.append(')');
        }
        else if(root.left!=null&&root.right==null)
        {
            sb.append('(');
            sb.append(dfs(root.left));
            sb.append(')');
        }
        else if(root.left==null&&root.right!=null)
        {
            sb.append('(');
            sb.append(')');
            sb.append('(');
            sb.append(dfs(root.right));
            sb.append(')');
        }
        else{}
        return sb.toString();
    }
    public String serialize(TreeNode root) {
        return dfs(root);
    }

    // Decodes your encoded data to tree.
    //1(2(4(8)(9))(5(10)(11)))(3(6(12)(13))(7(14)(15)))
    //1(2()(4))(3)
    public TreeNode strToTree(String str,int[] i)
    {
        if(str==null)
            return null;
        TreeNode node=null;
        if(str.charAt(i[0])=='-'||Character.isDigit(str.charAt(i[0])))
        {
            int flag=0,value=0;
            if(str.charAt(i[0])=='-')
            {
                i[0]++;
                flag=1;
            }
            while(i[0]<str.length()&&Character.isDigit(str.charAt(i[0])))
                value=value*10+str.charAt(i[0]++)-'0';
            if(flag==1)
                value=-value;
            node=new TreeNode(value);
            if(i[0]>=str.length())
                return node;
            if(str.charAt(i[0])=='(')
            {
                i[0]++;
                node.left=strToTree(str,i);
            }
            else if(str.charAt(i[0])==')')
            {
                i[0]++;
                return node;
            }
            else{}
            if(i[0]>=str.length())
                return node;
            if(str.charAt(i[0])=='(')
            {
                i[0]++;
                node.right=strToTree(str,i);
            }
            else if(str.charAt(i[0])==')')
            {
                i[0]++;
                return node;
            }
            else{}
            i[0]++;
        }
        else
        {
            if(str.charAt(i[0])==')')
            {
                i[0]++;
                return null;
            }
        }
        return node;
    }
    public TreeNode deserialize(String data) {
        return strToTree(data,new int[1]);
    }
}

