/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> zigzagLevelOrder(TreeNode root) {       
        if(root==null) 
            return new ArrayList<>();
        TreeNode[] arr=new TreeNode[2000];
        int p=-1,q=0;
        List<List<Integer>> ret=new ArrayList<>();
        arr[++p]=root;
        boolean check=false;
        //[1,2,3,4,5,6,7]
        while(p>=q)
        {
            int temp=p;
            List<Integer> list=new ArrayList<>();
            if(check)
                check=false;
            else
                check=true;
            while(q<=temp)
            {
                if(arr[q].left!=null)
                    arr[++p]=arr[q].left;
                if(arr[q].right!=null)
                    arr[++p]=arr[q].right;
                list.add(arr[q].val);
                q++;
            }
            if(!check)
                Collections.reverse(list);
            ret.add(list);
        }
        return ret;
    }
}