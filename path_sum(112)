/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean dfs(TreeNode root,int sum,int cur)
    {
        if(root==null)
            return false;
        if(root.left==null&&root.right==null&&cur+root.val==sum)
            return true;
        boolean bool=dfs(root.left,sum,cur+root.val);
        if(bool)
            return true;
        return dfs(root.right,sum,cur+root.val);
    }
    public boolean hasPathSum(TreeNode root, int sum) {
        return dfs(root,sum,0);
    }
}