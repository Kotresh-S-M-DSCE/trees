/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int st=0,ret=0;
    public void dfs(TreeNode root,int k)
    {
        if(root==null)
            return;
        dfs(root.left,k);
        if(ret!=0)
            return;
        st++;
        if(k==st)
        {
            ret=root.val;
            return;
        }
        dfs(root.right,k);
    }
    public int kthSmallest(TreeNode root, int k) {
        dfs(root,k);
        return ret;
    }
}